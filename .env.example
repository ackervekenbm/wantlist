# wantlist env
# Copy to .env and set the API keys.
#   GEMINI_API_KEY  https://aistudio.google.com/apikey  (free, no card)
#   SERPER_API_KEY  https://serper.dev                  (free: 2,500 one-time search credits, 6-mo expiry)
GEMINI_API_KEY=
SERPER_API_KEY=

# Optional: research worker tuning
# WORKER_INTERVAL_MS=900000
# WORKER_QUEUE_CAP=3

# Optional: model fallback chain.
# GEMINI_MODEL overrides the primary model; MODEL_CHAIN lists the Gemini
# fallbacks tried when a model's free-tier quota is exhausted (per-model).
# GROQ_API_KEY / OPENROUTER_API_KEY (either or both, free, no card) append an
# OpenAI-compatible last resort:
#   Groq      https://console.groq.com/keys
#   OpenRouter https://openrouter.ai/keys
# GEMINI_MODEL=gemini-3.8-flash
# MODEL_CHAIN=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free