# Dependency installs run without lifecycle scripts.
#
# better-sqlite3 ships prebuilds/<platform>.node for every platform it supports
# (glibc and musl, amd64 and arm64), so nothing needs to be compiled - but its
# tarball still contains binding.gyp and npm's lockfile metadata does not carry
# the package's "gypfile": false opt-out, so npm otherwise runs a legacy
# implicit `node-gyp rebuild` on every install. That wants python3/make/g++,
# silently recompiles SQLite where they exist, and throws away the prebuilds.
#
# esbuild (via vite/tsx) resolves its binary through optional
# @esbuild/<platform> packages and needs no script either. The Dockerfile and
# CI depend on this, so a dependency that genuinely needs an install script
# cannot be added without revisiting this file.
ignore-scripts=true
